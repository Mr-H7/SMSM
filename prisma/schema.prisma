generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SELLER
}

enum VariantGrade {
  ORIGINAL
  MIRROR
  EGYPTIAN
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum StorefrontBadge {
  NEW
  BESTSELLER
  LIMITED
  OFFER
}

enum WebOrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum ContactMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  fullName     String?
  role         Role     @default(SELLER)
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales          Sale[]
  createdReturns SaleReturn[] @relation("ReturnCreatedBy")
}

model ProductModel {
  id        String   @id @default(cuid())
  name      String
  brand     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants           ProductVariant[]
  storefrontProducts StorefrontProduct[]
}

model ProductVariant {
  id        String       @id @default(cuid())
  modelId   String
  grade     VariantGrade
  color     String?
  size      String?
  sku       String?      @unique
  sellPrice Int
  costPrice Int
  stockQty  Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  model              ProductModel               @relation(fields: [modelId], references: [id], onDelete: Cascade)
  items              SaleItem[]
  returnItems        SaleReturnItem[]
  replacementItems   SaleReturnReplacement[]
  storefrontMappings StorefrontProductVariant[]
  webOrderItems      WebOrderItem[]
}

model Sale {
  id                 String        @id @default(cuid())
  sellerId           String
  customer           String?
  total              Int
  discount           Int           @default(0)
  paymentMethod      PaymentMethod @default(CASH)
  paymentDescription String?
  createdAt          DateTime      @default(now())

  seller     User         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items      SaleItem[]
  returns    SaleReturn[]
  webOrderId String?      @unique
  webOrder   WebOrder?    @relation(fields: [webOrderId], references: [id], onDelete: SetNull)
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  variantId String
  qty       Int
  sellPrice Int
  costPrice Int

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems SaleReturnItem[]
}

model SaleReturn {
  id                    String     @id @default(cuid())
  saleId                String
  createdById           String
  type                  ReturnType
  reason                String?
  notes                 String?
  returnedGross         Int        @default(0)
  returnedDiscountShare Int        @default(0)
  returnedValue         Int        @default(0)
  replacementValue      Int        @default(0)
  refundAmount          Int        @default(0)
  extraAmount           Int        @default(0)
  createdAt             DateTime   @default(now())

  sale         Sale                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy    User                    @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        SaleReturnItem[]
  replacements SaleReturnReplacement[]

  @@index([saleId, createdAt])
  @@index([createdById, createdAt])
}

model SaleReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  saleItemId String
  variantId  String
  qty        Int
  unitPrice  Int
  lineTotal  Int
  createdAt  DateTime @default(now())

  return   SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@index([variantId])
}

model SaleReturnReplacement {
  id        String   @id @default(cuid())
  returnId  String
  variantId String
  qty       Int
  unitPrice Int
  lineTotal Int
  createdAt DateTime @default(now())

  return  SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([variantId])
}

model StorefrontCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameEn    String
  imagePath String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StorefrontProduct[]
}

model StorefrontProduct {
  id                 String           @id @default(cuid())
  approvedSku        String           @unique
  slug               String           @unique
  productModelId     String
  categoryId         String
  nameAr             String
  nameEn             String
  shortDescriptionAr String?
  shortDescriptionEn String?
  descriptionAr      String           @default("")
  descriptionEn      String           @default("")
  sizes              String[]         @default([])
  colors             String[]         @default([])
  compareAtPrice     Int?
  badge              StorefrontBadge?
  featured           Boolean          @default(false)
  isOffer            Boolean          @default(false)
  seoTitleAr         String?
  seoTitleEn         String?
  seoDescriptionAr   String?
  seoDescriptionEn   String?
  publishToWeb       Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  productModel ProductModel              @relation(fields: [productModelId], references: [id], onDelete: Restrict)
  category     StorefrontCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mapping      StorefrontProductVariant?
  images       StorefrontProductImage[]
  orderItems   WebOrderItem[]

  @@index([publishToWeb, updatedAt])
  @@index([categoryId])
  @@index([productModelId])
}

model StorefrontProductVariant {
  storefrontProductId String @id
  productVariantId    String

  storefrontProduct StorefrontProduct @relation(fields: [storefrontProductId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productVariantId])
}

model StorefrontProductImage {
  id                  String   @id @default(cuid())
  storefrontProductId String
  path                String
  angle               String?
  sortOrder           Int
  createdAt           DateTime @default(now())

  storefrontProduct StorefrontProduct @relation(fields: [storefrontProductId], references: [id], onDelete: Cascade)

  @@unique([storefrontProductId, sortOrder])
  @@index([storefrontProductId])
}

model WebOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  idempotencyKey  String         @unique
  customerName    String
  phone           String
  address         String
  notes           String?
  locale          String         @default("ar")
  status          WebOrderStatus @default(NEW)
  subtotal        Int
  total           Int
  seenAt          DateTime?
  contactedAt     DateTime?
  confirmedAt     DateTime?
  stockDeductedAt DateTime?
  cancelledAt     DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items WebOrderItem[]
  sale  Sale?

  @@index([status, createdAt])
  @@index([seenAt, createdAt])
}

model WebOrderItem {
  id                  String   @id @default(cuid())
  webOrderId          String
  storefrontProductId String
  productVariantId    String
  productNameAr       String
  productNameEn       String
  imagePath           String
  unitPrice           Int
  compareAtPrice      Int?
  selectedSize        String
  selectedColor       String
  quantity            Int
  lineTotal           Int
  createdAt           DateTime @default(now())

  webOrder          WebOrder          @relation(fields: [webOrderId], references: [id], onDelete: Restrict)
  storefrontProduct StorefrontProduct @relation(fields: [storefrontProductId], references: [id], onDelete: Restrict)
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([webOrderId])
  @@index([productVariantId])
  @@index([storefrontProductId])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  contact   String
  message   String
  status    ContactMessageStatus @default(UNREAD)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}
